from __future__ import annotations

from datetime import date
from typing import Any

SUPPORTED_FORMS = {"10-K", "10-Q", "8-K"}


def _rows_from_recent(recent: dict[str, list]) -> list[dict[str, Any]]:
    keys = [
        "accessionNumber", "filingDate", "reportDate", "acceptanceDateTime",
        "form", "primaryDocument", "primaryDocDescription", "isXBRL", "isInlineXBRL",
    ]
    count = len(recent.get("accessionNumber", []))
    return [
        {key: recent.get(key, [None] * count)[i] for key in keys}
        for i in range(count)
    ]


def discover_company_filings(
    client,
    cik: str,
    ticker: str,
    company: str,
    *,
    forms: set[str] | None = None,
    start_date: str | None = None,
    end_date: str | None = None,
) -> list[dict[str, Any]]:
    """Discover filing inventory from SEC submissions, including older shards."""
    forms = forms or SUPPORTED_FORMS
    unknown = forms - SUPPORTED_FORMS
    if unknown:
        raise ValueError(f"Unsupported forms: {sorted(unknown)}")
    start = date.fromisoformat(start_date) if start_date else None
    end = date.fromisoformat(end_date) if end_date else None

    submissions = client.get_submissions(cik)
    records = _rows_from_recent(submissions.get("filings", {}).get("recent", {}))

    for shard in submissions.get("filings", {}).get("files", []):
        shard_name = shard.get("name")
        filing_from = shard.get("filingFrom")
        filing_to = shard.get("filingTo")
        if not shard_name:
            continue
        if start and filing_to and date.fromisoformat(filing_to) < start:
            continue
        if end and filing_from and date.fromisoformat(filing_from) > end:
            continue
        historical = client.get_submission_history(shard_name)
        records.extend(_rows_from_recent(historical))

    output = []
    seen = set()
    for row in records:
        form = row.get("form")
        filing_date = row.get("filingDate")
        accession = row.get("accessionNumber")
        primary = row.get("primaryDocument")
        if form not in forms or not filing_date or not accession or not primary:
            continue
        filing_day = date.fromisoformat(filing_date)
        if start and filing_day < start:
            continue
        if end and filing_day > end:
            continue
        if accession in seen:
            continue
        seen.add(accession)
        output.append({
            "cik": str(cik).zfill(10),
            "ticker": ticker,
            "company": company,
            "form_type": form,
            "accession_number": accession,
            "filing_date": filing_date,
            "report_date": row.get("reportDate"),
            "acceptance_datetime": row.get("acceptanceDateTime"),
            "primary_document": primary,
            "primary_document_description": row.get("primaryDocDescription"),
            "is_xbrl": row.get("isXBRL"),
            "is_inline_xbrl": row.get("isInlineXBRL"),
            "source_url": client.filing_url(cik, accession, primary),
            "ingestion_status": "discovered",
        })
    return sorted(output, key=lambda x: (x["filing_date"], x["ticker"], x["form_type"]), reverse=True)
